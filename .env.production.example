# ==============================================================================
# FICHEIRO DE CONFIGURAÇÃO DE PRODUÇÃO (EXEMPLO)
# Copie este ficheiro para ".env.production" no servidor da empresa e preencha
# os valores. Nunca envie o ficheiro ".env.production" real para o Git!
# ==============================================================================

# 1. Base de Dados SQL Server
# Gere uma palavra-passe complexa (ex.: openssl rand -base64 24)
MSSQL_SA_PASSWORD=SuaPasswordForteSqlSaAqui123!

# 2. JWT (Segurança de Sessão)
# Deve ser uma string longa e aleatória (ex.: openssl rand -base64 48)
JWT_SECRET=ChaveSuperSecretaJwtDeProducaoQueDeveTerPeloMenos256BitsAqui

# 3. Cifragem em Repouso (Segurança física de ficheiros e backups)
# Chave AES-256 de 32 bytes codificada em Base64 (Gere com: openssl rand -base64 32)
# ATENÇÃO: Se perder esta chave, os uploads e backups existentes ficam inacessíveis!
CIFRAGEM_KEY_BASE64=ChaveAes32BytesBase64Aqui=

# 4. URLs de Acesso
# URL de acesso público/LAN ao frontend Next.js (ex: http://192.168.1.100:3000)
FRONTEND_BASE_URL=http://localhost:3000

# URL do endpoint da API (ex: http://192.168.1.100:5078)
NEXT_PUBLIC_API_URL=http://localhost:5078

# 5. Configuração de Email SMTP (Opcional - caso queira enviar e-mails reais no cliente)
# Se estes campos forem deixados em branco, o sistema grava os e-mails num ficheiro local (emails_confirmacao.txt).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 6. Bootstrap Inicial
# Altere para "true" apenas no primeiro arranque para registar o primeiro administrador na UI.
# Após criar a primeira conta Admin, altere novamente para "false" para blindar o sistema.
ALLOW_BOOTSTRAP=true
